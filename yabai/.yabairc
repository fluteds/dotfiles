#!/usr/bin/env bash

set -x

# ====== Variables =============================

declare -A gaps
declare -A color

gaps["top"]="0"
gaps["bottom"]="0"
gaps["left"]="0"
gaps["right"]="0"
gaps["inner"]="0"

color["preselect"]="0xE02d74da"

# ===== Loading Scripting Additions ============

# See: https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#macos-big-sur---automatically-load-scripting-addition-on-startup
# Sometimes you have to run sudo yabai --load-sa manually if scripts don't work.
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# ===== Tiling setting =========================

yabai -m config layout bsp

yabai -m config top_padding "${gaps["top"]}"
yabai -m config bottom_padding "${gaps["bottom"]}"
yabai -m config left_padding "${gaps["left"]}"
yabai -m config right_padding "${gaps["right"]}"
yabai -m config window_gap "${gaps["inner"]}"

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off

yabai -m config window_topmost off
yabai -m config window_opacity off
yabai -m config window_shadow off

yabai -m config window_border off

yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 1.0
yabai -m config split_ratio 0.50

yabai -m config auto_balance off

yabai -m config mouse_modifier fn
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# ===== Rules ==================================

# --- System Utilities ---
yabai -m rule --add label="Finder" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add label="System Preferences" app="^System Preferences$" title=".*" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add label="Software Update" title="Software Update" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off
yabai -m rule --add label="Activity Monitor" app="^Activity Monitor$" manage=off
yabai -m rule --add label="App Store" app="^App Store$" manage=off

# --- Productivity ---
yabai -m rule --add app="^Emacs$" manage=on
yabai -m rule --add app="^Todoist$" manage=off
yabai -m rule --add label="KeePassXC" app="^KeePassXC$" manage=off
yabai -m rule --add label="Dictionary" app="^Dictionary$" manage=off
yabai -m rule --add label="Calculator" app="^Calculator$" manage=off
yabai -m rule --add app="^Calculator$" manage=off

# --- Media ---
yabai -m rule --add label="mpv" app="^mpv$" manage=off
yabai -m rule --add label="vlc" app="^vlc$" manage=off

# --- Browsers ---
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off

# --- Games ---
yabai -m rule --add app="^java$" title=".*Minecraft.*" manage=off
yabai -m rule --add app="^(Steam|Epic Games)$" manage=off
yabai -m rule --add label="On-Together" app="^On-Together$" manage=off

# --- Remote/Desktop ---
yabai -m rule --add label="Parsec" app="Parsec" manage=off
yabai -m rule --add label="iPhone Mirroring" app="^iPhone Mirroring$" manage=off

# --- Miscellaneous ---
yabai -m rule --add label="macfeh" app="^macfeh$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add label="FaceTime" app="^FaceTime$" manage=off
yabai -m rule --add label="CARROT Weather" app="^CARROT Weather$" manage=off
yabai -m rule --add label="CleanShot X" app="^CleanShot X$" manage=off

# --- Set SketchyBar Behavior ----------------
yabai -m config external_bar all:0:0

# Starts Borders Process
borders active_color=0xffebbcba inactive_color=0xff403d52 width=3.0 style=square &

# Load
set +x
printf "yabai: configuration loaded\\n"

