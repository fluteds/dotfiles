[core]
	excludesfile = ~/.gitignore
	editor = vim
	pager = delta
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[interactive]
	diffFilter = delta --color-only
[credential]
	helper = osxkeychain
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[help]
	autocorrect = 1
[merge]
	conflictstyle = diff3
[github]
	user = fluteds
[push]
	default = simple
[user]
	name = fluteds
	email = fluteds@users.noreply.github.com
[url "https://github.com/"]
	insteadOf = git@github.com:
